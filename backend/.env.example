# IBM Bob Shell. Create an API key in the Bob web portal (bob.ibm.com) with Scope = Inference.
BOB_API_KEY=your_bob_api_key

# Set to true to accept the IBM Bob Shell license for headless runs (required on servers).
BOB_ACCEPT_LICENSE=false

# IBM watsonx.ai: backup used when Bob fails (e.g. out of bobcoins).
#   API key:    IBM Cloud > Manage > Access (IAM) > API keys
#   Project ID: watsonx.ai project > Manage tab > General
#   URL:        your project's region, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your_watsonx_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Groq: backup (fast, free tier). Key from console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini: backup. Key from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# Order to try providers in (skips any without a key)
AI_PROVIDERS=bob,watsonx,groq,gemini

# Optional:
# BOB_COMMAND=bob          full path to the bob executable if it isn't on PATH
# BOB_MODE=ask             Bob Shell mode used for generation
# BOB_MAX_COST=5           stop a request after this many bobcoins
